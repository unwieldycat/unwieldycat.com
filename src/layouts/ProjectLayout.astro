---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProjectLinks from "../components/ProjectLinks.astro";
import Footer from "../components/Footer.astro";

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>uwc - {frontmatter.title}</title>
	</head>
	<body>
		<div class="max-w-3xl mx-auto divide-y border">
			<Header />
			<Breadcrumbs />
			<div class="flex flex-col gap-2 p-4">
				<div
					class="flex flex-row justify-between items-center flex-wrap"
				>
					<h1 class="mr-4">{frontmatter.title}</h1>
					{
						frontmatter.links && (
							<ProjectLinks links={frontmatter.links} />
						)
					}
				</div>

				<slot />
			</div>
			<Footer />
		</div>
	</body>
</html>
